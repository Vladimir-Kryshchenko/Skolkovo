

POSTGRES_USER=skolkovo
POSTGRES_PASSWORD=skolkovo
POSTGRES_DB=skolkovo
POSTGRES_DSN=postgres://skolkovo:skolkovo@localhost:5432/skolkovo?sslmode=disable

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=skolkovo_docs
# Страницы публичного сайта — отдельная коллекция (не файлы-документы)
SITEPAGES_COLLECTION=skolkovo_sitepages
SITEPAGES_ENABLED=true
SITEPAGES_SEEDS=https://sk.ru/,https://dochub.sk.ru/foundation/documents/
SITEPAGES_MAX_PAGES=0
# Лимит query-вариантов одного пути (защита от бесконечных календарей/фасетов); 0 — без лимита
SITEPAGES_MAX_PER_PATH=1000
# Обход через headless-браузер (chromedp) — для разделов с JS-навигацией; медленнее
SITEPAGES_RENDER_JS=false
# Число параллельных загрузчиков при обходе (1 — последовательно)
SITEPAGES_CONCURRENCY=4

TEI_URL=http://localhost:8081
EMBEDDING_DIM=768

SOURCE_URL=https://dochub.sk.ru/foundation/documents/

DOCS_DIR=./Р”РѕРєСѓРјРµРЅС‚С‹_РЎРєРѕР»РєРѕРІРѕ

STORE_BACKEND=postgres
REGISTRY_PATH=./Р”РѕРєСѓРјРµРЅС‚С‹_РЎРєРѕР»РєРѕРІРѕ/РњРµС‚Р°РґР°РЅРЅС‹Рµ/СЂРµРµСЃС‚СЂ_РґРѕРєСѓРјРµРЅС‚РѕРІ.json

REPORT_DIR=./РђРЅР°Р»РёС‚РёРєР°/РћС‚С‡РµС‚С‹/РћС‚С‡РµС‚С‹_РїР°СЂСЃРёРЅРіР°
SCRAPE_INTERVAL=6h

SCRAPE_MAX_PAGES=200
SCRAPE_DELAY=3s

NEWS_RSS_URL=https://sk.ru/news/rss/

NOTIFY_WEBHOOK=

QWEN_API_KEY=sk-ws-H.HLEIDR.ED70.MEQCIF82r_BLutmUDXe-2jp2YBfRmfC-TkE6JMhOEKGL_qbPAiAOZGqcrfXynKwj7xIvgXd9WjWw1_wga0JftdtC2-krXg

# ИИ-аннотирование страниц сайта (теги/описание/цели/тезисы/выводы). По умолчанию
# включено; работает только при настроенной LLM-модели (QWEN_API_KEY выше или
# модель в /ai/models + включённый агент «Аннотатор страниц»).
SITEPAGES_ENRICH_ENABLED=true
# Пауза между LLM-запросами при аннотировании (троттлинг лимитов провайдера).
SITEPAGES_ENRICH_DELAY=1s
# Сколько страниц размечать за один прогон (кап). Большая база (десятки тысяч
# страниц) добирается порциями на периодических прогонах задания «sitepages»,
# без многочасового блокирующего прогона. Поднимите, чтобы добирать быстрее.
SITEPAGES_ENRICH_MAX_PER_RUN=500
# Параллелизм разметки (пул воркеров): сколько страниц/документов размечать
# одновременно. Выше — быстрее, но больше одновременных запросов к LLM (следите
# за лимитами; авто-переключение моделей при ошибке/лимите включено).
SITEPAGES_ENRICH_CONCURRENCY=6
DOC_ENRICH_CONCURRENCY=4

# ИИ-разметка документов: категория (из 8 канонических), подкатегория и теги
# агентом «Аннотатор документов». По умолчанию включено; работает при настроенной
# LLM-модели. На старте — бэкфилл действующих документов без разметки.
DOC_ENRICH_ENABLED=true
DOC_ENRICH_DELAY=1s

# Скачивание тел файлов dochub. РАБОЧИЙ способ — сессионная кука браузера
# (DOCHUB_COOKIE): WAF dochub (ServicePipe) блокирует ЛЮБУЮ автоматизацию (curl,
# headless/headful chromedp) на страницах документов — НЕЗАВИСИМО от IP, поэтому
# прокси НЕ помогает (проверено: датацентр/мобильный RU·US/чистый IP — все блок).
# Но с кукой реального браузера, прошедшего WAF, обычный HTTP качает файлы с
# любого IP, без браузера и прокси. Куку проще задавать в админке (/proxy →
# «Кука dochub»); env ниже — фоллбэк. Кука периодически протухает — обновляйте.
DOCHUB_COOKIE=
# PROXY_URL / PROXY6_API_KEY оставлены для совместимости, но для файлов dochub
# НЕ нужны (см. выше). CHROME_PATH нужен лишь старому headless-фоллбэку.
CHROME_PATH=/usr/bin/chromium
PROXY_URL=
PROXY6_API_KEY=
FETCH_LIMIT=0
FETCH_WAIT=7s

MCP_ADDR=:8080
MCP_API_KEY=517a4b18d8701532ce5e9d50671395b8602a9f9e68691f1d
MCP_RATE_LIMIT_RPS=5
# Публичный базовый URL для ссылок на скачанные копии документов в ответах
# консультанта: при наличии локальной копии источник ведёт на <base>/files/{id}
# (этот путь обслуживает MCP-сервер, :8080). Прямые ссылки на тело документа
# dochub (/m/docs/) блокирует WAF (403), поэтому без копии источник
# автоматически ведёт на открытую страницу-листинг категории dochub.
# Укажите внешний адрес, проксируемый nginx на :8080 (напр. https://213.136.75.7),
# и пробросьте в nginx location /files/ → :8080. Пусто — копии не отдаём,
# работает только фолбэк на категорию (ссылки всё равно не битые).
DOC_PUBLIC_BASE_URL=

ADMIN_ADDR=:8090
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# --- Telegram ---
# Глобальный токен бота (@BotFather). Задействован в двух местах:
#  1) бот для клиентов резидентства — поднимается как бот тенанта «Default»
#     (если у Default не задан собственный токен в админке :8091 → /tenants);
#  2) алерты консультанту об изменениях (вместе с CONSULTANT_TELEGRAM_CHAT_ID).
# Персональные боты тенантов задаются НЕ здесь, а в админке (свой токен на тенанта).
# Пусто — глобальный бот не поднимается (персональные боты тенантов работают).
TELEGRAM_BOT_TOKEN=
# @username бота — для ссылок в интерфейсе (опционально).
TELEGRAM_BOT_USERNAME=
# chat_id консультанта/менеджера для Telegram-алертов об изменениях (опционально).
CONSULTANT_TELEGRAM_CHAT_ID=
